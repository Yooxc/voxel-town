{
  "name": "voxel-town",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:rebuild": "vite --mode rebuild --port 5174 --strictPort",
    "build": "vite build",
    "build:rebuild": "vite build --mode rebuild",
    "preview": "vite preview",
    "test:wasteland": "node --test tests/frontier.wasteland.test.js",
    "server:dev": "npm --prefix server run dev",
    "server:rebuild": "node --watch server/src/index.js --mode=rebuild",
    "server:start": "npm --prefix server run start"
  },
  "devDependencies": {
    "vite": "^7.2.4"
  },
  "dependencies": {
    "three": "^0.182.0"
  }
}
